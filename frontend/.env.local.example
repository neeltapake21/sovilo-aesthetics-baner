# Frontend environment variables (copy to .env.local)
VITE_API_BASE=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# IMPORTANT GOOGLE OAUTH NOTES:
# 1) In Google Cloud Console -> APIs & Services -> Credentials create an "OAuth 2.0 Client ID" of type "Web application".
# 2) Add this to "Authorized JavaScript origins":
#      http://localhost:5173
#    (also add your deployed origin for production)
# 3) Use the same client id string for `GOOGLE_CLIENT_ID` in the backend .env.
# 4) For local dev ensure you restart the frontend after updating `.env.local`.
