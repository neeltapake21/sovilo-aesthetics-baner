# Backend environment variables (copy to .env and set real values)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=sovilo
JWT_SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-password
CLINIC_EMAIL=clinic@example.com

# IMPORTANT GOOGLE OAUTH NOTES:
# 1) In Google Cloud Console -> APIs & Services -> Credentials create an "OAuth 2.0 Client ID" of type "Web application".
# 2) Add the frontend origin to "Authorized JavaScript origins":
#      http://localhost:5173
#    (and your production origin e.g. https://yourdomain.com)
# 3) If you use redirect-based OAuth flows, also add any redirect URIs under "Authorized redirect URIs".
# 4) Set the same client id value into the frontend `VITE_GOOGLE_CLIENT_ID` and backend `GOOGLE_CLIENT_ID`.
# 5) Restart frontend and backend after changing env values.
